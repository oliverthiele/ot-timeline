{
	"name": "oliverthiele/ot-timeline",
	"type": "typo3-cms-extension",
	"description": "CE Timeline - Content element for displaying a vertical timeline.",
	"homepage": "https://www.oliver-thiele.de/",
	"license": [
		"GPL-2.0-or-later"
	],
	"authors": [
		{
			"name": "Oliver Thiele",
			"email": "mail@oliver-thiele.de",
			"role": "Developer",
			"homepage": "https://www.oliver-thiele.de/"
		}
	],
	"keywords": [
		"typo3",
		"timeline",
		"content element"
	],
	"require": {
		"php": ">=8.2",
		"typo3/cms-core": "^13.4||^14.3"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"saschaegerer/phpstan-typo3": "^3.0",
		"roave/security-advisories": "dev-latest"
	},
	"autoload": {
		"psr-4": {
			"OliverThiele\\OtTimeline\\": "Classes"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "ot_timeline"
		}
	},
	"support": {
		"issues": "https://github.com/oliverthiele/ot-timeline/issues",
		"source": "https://github.com/oliverthiele/ot-timeline"
	}
}