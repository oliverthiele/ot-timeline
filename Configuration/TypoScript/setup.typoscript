tt_content {
  ot_timeline =< lib.contentElement
  ot_timeline {
    templateName = Timeline
    # Index 0 replaces only the fluid_styled_content templates, which this
    # element does not use. Index 10 stays free for the project override via
    # styles.templates.templateRootPath. Layouts and partials are inherited
    # from lib.contentElement.
    templateRootPaths {
      0 = EXT:ot_timeline/Resources/Private/Templates/
    }
    dataProcessing {
      1734357419 = database-query
      1734357419 {
        if.isTrue.field = timeline_items
        table = tx_ottimeline_timeline_item
        where.data = field:_ORIG_uid // field:uid
        where.intval = 1
        where.wrap = tx_ottimeline_timeline_item.parent_id=|

        orderBy = sorting
        as = timelineItems

        dataProcessing {
          10 = files
          10 {
            references.fieldName = images
            references.table = tx_ottimeline_timeline_item
          }
        }
      }
    }
  }
}
